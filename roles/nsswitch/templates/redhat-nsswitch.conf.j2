#
# /etc/nsswitch.conf
#
# An example Name Service Switch config file. This file should be
# sorted with the most-used services at the beginning.
#
# The entry '[NOTFOUND=return]' means that the search for an
# entry should stop if the search in the previous entry turned
# up nothing. Note that if the search failed due to some other reason
# (like no NIS server responding) then the search continues with the
# next entry.
#
# Valid entries include:
#
#	nisplus			Use NIS+ (NIS version 3)
#	nis			Use NIS (NIS version 2), also called YP
#	dns			Use DNS (Domain Name Service)
#	files			Use the local files
#	db			Use the local database (.db) files
#	compat			Use NIS on compat mode
#	hesiod			Use Hesiod for user lookups
#	sss			Use sssd (System Security Services Daemon)
#	[NOTFOUND=return]	Stop searching if not found so far
#
# WARNING: Running nscd with a secondary caching service like sssd may lead to
# 	   unexpected behaviour, especially with how long entries are cached.

# To use db, put the "db" in front of "files" for entries you want to be
# looked up first in the databases
#
# Example:
#passwd:    db files nisplus nis
#shadow:    db files nisplus nis
#group:     db files nisplus nis

{# sss dropped from these defaults: nothing installs/configures SSSD, and
   listing it here while SSSD isn't actually running breaks PAM's account
   phase (NSS can't resolve the calling user), failing sudo entirely. Still
   available via the nsswitch_* override vars for hosts that do run SSSD. #}
{% if nsswitch_passwd is defined %}
passwd:     {{ nsswitch_passwd | join(' ') }}
{% else %}
passwd:     files
{% endif %}
{% if nsswitch_shadow is defined %}
shadow:     {{ nsswitch_shadow | join(' ') }}
{% else %}
shadow:     files
{% endif %}
{% if nsswitch_group is defined %}
group:      {{ nsswitch_group | join(' ') }}
{% else %}
group:      files
{% endif %}
{% if nsswitch_initgroups is defined %}
initgroup:   {{ nsswitch_initgroups | join(' ') }}
{% else %}
#initgroups: files sss
{% endif %}

#hosts:     db files nisplus nis dns
{% if nsswitch_hosts is defined %}
hosts:      {{ nsswitch_hosts | join(' ') }}
{% else %}
hosts:      files dns
{% endif %}

# Example - obey only what nisplus tells us...
#services:   nisplus [NOTFOUND=return] files
#networks:   nisplus [NOTFOUND=return] files
#protocols:  nisplus [NOTFOUND=return] files
#rpc:        nisplus [NOTFOUND=return] files
#ethers:     nisplus [NOTFOUND=return] files
#netmasks:   nisplus [NOTFOUND=return] files

{# nisplus dropped from these defaults too: glibc removed NIS+ support
   entirely (no libnss_nisplus.so module ships on modern systems), and an
   NSS database naming a module that can't be loaded at all - as opposed to
   one that's merely unavailable - breaks the whole lookup for that
   database, including netgroup lookups PAM's account phase depends on. #}
{% if nsswitch_bootparams is defined %}
bootparams: {{ nsswitch_bootparams | join(' ') }}
{% else %}
bootparams: files
{% endif %}

{% if nsswitch_ethers is defined %}
ethers:     {{ nsswitch_ethers | join(' ') }}
{% else %}
ethers:     files
{% endif %}
{% if nsswitch_netmasks is defined %}
netmasks:   {{ nsswitch_netmasks | join(' ') }}
{% else %}
netmasks:   files
{% endif %}
{% if nsswitch_networks is defined %}
networks:   {{ nsswitch_networks | join(' ') }}
{% else %}
networks:   files
{% endif %}
{% if nsswitch_protocols is defined %}
protocols:  {{ nsswitch_protocols | join(' ') }}
{% else %}
protocols:  files
{% endif %}
{% if nsswitch_rpc is defined %}
rpc:        {{ nsswitch_rpc | join(' ') }}
{% else %}
rpc:        files
{% endif %}
{% if nsswitch_services is defined %}
services:   {{ nsswitch_services | join(' ') }}
{% else %}
services:   files
{% endif %}

{% if nsswitch_netgroup is defined %}
netgroup:   {{ nsswitch_netgroup | join(' ') }}
{% else %}
netgroup:   files
{% endif %}

{% if nsswitch_publickey is defined %}
publickey:  {{ nsswitch_publickey | join(' ') }}
{% else %}
publickey:  files
{% endif %}

{% if nsswitch_automount is defined %}
automount:  {{ nsswitch_automount | join(' ') }}
{% else %}
automount:  files
{% endif %}
{% if nsswitch_aliases is defined %}
aliases:    {{ nsswitch_aliases | join(' ') }}
{% else %}
aliases:    files

{% endif %}
